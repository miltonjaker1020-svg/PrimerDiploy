# Supabase PostgreSQL. Use the Session Pooler URL (port 5432) when IPv4 is needed.
# URL-encode special characters in the database password. Do not commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Generate TWO different secrets with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Seed clears application data. Keep false; opt in only for an empty/demo database.
SEED_ALLOW_RESET=false
